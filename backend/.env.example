# AgentDB Backend Environment Configuration

# Server Settings
APP_NAME=AgentDB
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-super-secret-key-for-production-min-32-chars

# Database Configuration (MySQL)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/agentdb

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
