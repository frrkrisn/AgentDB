# AgentDB Backend Environment Configuration

# Server Settings
APP_NAME=AgentDB
DEBUG=True
API_V1_STR=/api/v1

# JWT Authentication
# SECRET_KEY must be set via environment variable in production.
# This file is gitignored; never commit a real secret.
SECRET_KEY=change-this-to-a-very-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (MySQL)
DATABASE_URL=mysql+pymysql://root:***@localhost:3306/agentdb

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]